<?php

class walletController extends Controller {

    public function __construct() {
   
        $this->walletModel = $this->model('walletModel');
    }

    public function wallet() {

        $user_id = 1; 
        $balanceData = $this->walletModel->getBalance($user_id);

        $data = [
            'balance' => $balanceData
        ];

        $this->view("users/Driver/wallet", $data);
    }

    public function deposit() {
        if ($_SERVER['REQUEST_METHOD'] == 'POST') {

            $amount = $_POST['amount'];
            $user_id = 1;

            if ($this->walletModel->deposit($user_id, $amount)) {

                header("Location: ?url=walletController/wallet");
                exit();
            } else {
                die("Error: Database could not update.");
            }
        }
    }
}